# Optional. With no key, TROPOS clearly labels its local rule mode.
# Copy this file to .env and fill locally. Never commit .env.
TROPOS_LLM_API_KEY=
# DEEPSEEK_API_KEY is also recognized if TROPOS_LLM_API_KEY is empty.
TROPOS_LLM_BASE_URL=https://api.deepseek.com
TROPOS_LLM_MODEL=deepseek-flash
TROPOS_LLM_TIMEOUT=15
