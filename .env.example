# Optional model-center configuration. With no key, TROPOS safely uses local rules.
# Copy this file to .env and fill locally. Never commit .env or put keys in the browser.

# Authentication mail. Leave SMTP_HOST blank to use the private .local/mail-outbox
# development fallback. Production must use HTTPS and a real transactional mailbox.
TROPOS_PUBLIC_URL=http://127.0.0.1:8765
TROPOS_SMTP_HOST=
TROPOS_SMTP_PORT=587
TROPOS_SMTP_USERNAME=
TROPOS_SMTP_PASSWORD=
TROPOS_SMTP_FROM=
TROPOS_SMTP_SSL=0
TROPOS_SMTP_STARTTLS=1
# Optional URL-safe base64 value decoding to 32+ random bytes. If blank, a
# private key file is created beside the SQLite database and must be backed up.
TROPOS_AUTH_MASTER_KEY=

# Optional official Meituan Paotui connector. Local development can normally
# use its auto-detected Skill and Node; set a private writable state directory
# when the application root is read-only.
TROPOS_MEITUAN_SKILL_DIR=
TROPOS_MEITUAN_NODE_BIN=
TROPOS_MEITUAN_PASSPORT_JS=
TROPOS_MEITUAN_STATE_DIR=

# DeepSeek
TROPOS_DEEPSEEK_API_KEY=
TROPOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
TROPOS_DEEPSEEK_MODEL=deepseek-flash
TROPOS_DEEPSEEK_TIMEOUT=15

# OpenAI API (a ChatGPT subscription is not an API key)
TROPOS_OPENAI_API_KEY=
TROPOS_OPENAI_BASE_URL=https://api.openai.com/v1
TROPOS_OPENAI_MODEL=
TROPOS_OPENAI_TIMEOUT=15

# Kimi / Moonshot OpenAI-compatible endpoint
TROPOS_KIMI_API_KEY=
TROPOS_KIMI_BASE_URL=https://api.moonshot.cn/v1
TROPOS_KIMI_MODEL=kimi-k3
TROPOS_KIMI_TIMEOUT=15

# Qwen / Alibaba Cloud Model Studio OpenAI-compatible endpoint
TROPOS_QWEN_API_KEY=
TROPOS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TROPOS_QWEN_MODEL=qwen-plus
TROPOS_QWEN_TIMEOUT=30

# Any other OpenAI-compatible /chat/completions endpoint
TROPOS_CUSTOM_LLM_API_KEY=
TROPOS_CUSTOM_LLM_BASE_URL=
TROPOS_CUSTOM_LLM_MODEL=
TROPOS_CUSTOM_LLM_TIMEOUT=15

# Legacy single-provider settings remain supported for existing deployments.
TROPOS_LLM_API_KEY=
# DEEPSEEK_API_KEY is also recognized if TROPOS_LLM_API_KEY is empty.
TROPOS_LLM_BASE_URL=https://api.deepseek.com
TROPOS_LLM_MODEL=deepseek-flash
TROPOS_LLM_TIMEOUT=15
