# Existing instance/domain only. Keep production values on the server.
TROPOS_SITE_ADDRESS=demo.troposagent.com
TROPOS_PUBLIC_URL=https://demo.troposagent.com

# Transactional email used for verification and password recovery.
TROPOS_SMTP_HOST=
TROPOS_SMTP_PORT=465
TROPOS_SMTP_USERNAME=
TROPOS_SMTP_PASSWORD=
TROPOS_SMTP_FROM=
TROPOS_SMTP_SSL=1
TROPOS_SMTP_STARTTLS=0
# Generate once with a CSPRNG, encode as URL-safe base64, keep outside Git,
# and back it up. Rotating it invalidates existing TOTP enrollments.
TROPOS_AUTH_MASTER_KEY=

# Optional official Meituan Paotui connector. Docker Compose supplies the
# in-container paths; keep provider programs read-only and state persistent.
TROPOS_MEITUAN_NODE_BIN=/usr/local/bin/node
TROPOS_MEITUAN_SKILL_DIR=/opt/tropos-meituan/skill
TROPOS_MEITUAN_PASSPORT_JS=/opt/tropos-meituan/runtime/package/dist/index.js
TROPOS_MEITUAN_STATE_DIR=/opt/tropos-meituan/runtime/state

# Optional model center. Leave blank to keep the deterministic local-rule mode.
# Secrets belong only in deploy/.env.production on the server; never commit it.
TROPOS_DEEPSEEK_API_KEY=
TROPOS_DEEPSEEK_BASE_URL=https://api.deepseek.com
TROPOS_DEEPSEEK_MODEL=deepseek-flash
TROPOS_DEEPSEEK_TIMEOUT=15
TROPOS_OPENAI_API_KEY=
TROPOS_OPENAI_BASE_URL=https://api.openai.com/v1
TROPOS_OPENAI_MODEL=
TROPOS_OPENAI_TIMEOUT=15
TROPOS_KIMI_API_KEY=
TROPOS_KIMI_BASE_URL=https://api.moonshot.cn/v1
TROPOS_KIMI_MODEL=kimi-k3
TROPOS_KIMI_TIMEOUT=15
TROPOS_QWEN_API_KEY=
TROPOS_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
TROPOS_QWEN_MODEL=qwen-plus
TROPOS_QWEN_TIMEOUT=30
TROPOS_CUSTOM_LLM_API_KEY=
TROPOS_CUSTOM_LLM_BASE_URL=
TROPOS_CUSTOM_LLM_MODEL=
TROPOS_CUSTOM_LLM_TIMEOUT=15
